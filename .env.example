# Copy to .env and adjust values. Used by docker-compose.

# PostgreSQL
POSTGRES_USER=sparta
POSTGRES_PASSWORD=sparta_password
POSTGRES_DB=sparta

# Backend
JWT_SECRET=change_me_in_production
# Used for local (non-Docker) drizzle-kit / backend runs.
# Inside docker-compose the backend builds its own DATABASE_URL from the
# POSTGRES_* values above (host = "database").
DATABASE_URL=postgres://sparta:sparta_password@localhost:5432/sparta
# Optional: comma-separated CORS allowlist. If unset the backend defaults to
# the production domain + http://localhost:3000.
# CORS_ORIGINS=https://sparta.jearimjarden.com,http://localhost:3000

# Frontend
# IMPORTANT: NEXT_PUBLIC_* is inlined at BUILD time by Next.js, so this value
# must be present when the frontend image is built (see DEPLOYMENT.md).
#   Local dev:   http://localhost:3001
#   Production:  https://sparta.jearimjarden.com
NEXT_PUBLIC_API_URL=http://localhost:3001
