# Copy to .env and adjust values. Used by docker-compose.

# Deployment domain + TLS (nginx + certbot)
# DOMAIN drives the nginx server_name, the Let's Encrypt certificate, and the
# defaults for CORS_ORIGINS and NEXT_PUBLIC_API_URL below. No domain is
# hardcoded anywhere — set it here.
DOMAIN=sparta.example.com
# Email Let's Encrypt uses for expiry / security notices (required by certbot).
CERTBOT_EMAIL=admin@example.com
# Set to 1 to use Let's Encrypt's STAGING environment while testing the setup
# (avoids rate limits; certs are untrusted). Set to 0 for real certificates.
CERTBOT_STAGING=0
# PRODUCTION ONLY: uncomment so every `docker compose ...` command automatically
# layers the nginx + certbot overlay on the base file. Leave commented for local
# development (base file only). scripts/init-letsencrypt.sh applies both anyway.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# PostgreSQL
POSTGRES_USER=sparta
POSTGRES_PASSWORD=sparta_password
POSTGRES_DB=sparta

# Backend
JWT_SECRET=change_me_in_production
# Used for local (non-Docker) drizzle-kit / backend runs.
# Inside docker-compose the backend builds its own DATABASE_URL from the
# POSTGRES_* values above (host = "database").
DATABASE_URL=postgres://sparta:sparta_password@localhost:5432/sparta
# Optional: comma-separated CORS allowlist. If unset, docker-compose defaults
# it to https://${DOMAIN}. Add extra origins (e.g. localhost) here if needed.
# CORS_ORIGINS=https://sparta.example.com,http://localhost:3000

# SMTP (assessment result emails). If SMTP_HOST is unset, email is disabled
# and sends are skipped/logged — assessment submission is never affected.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sparta.example.com

# OpenAI (AI question import + premium report). If OPENAI_API_KEY is unset, AI
# features return a clear error and the rest of the app still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional: override the API base (e.g. Azure/OpenAI-compatible proxy).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Frontend
# IMPORTANT: NEXT_PUBLIC_* is inlined at BUILD time by Next.js. docker-compose
# passes it as a build arg, defaulting to https://${DOMAIN} (same-origin via
# nginx) when left unset — so you normally do NOT need to set it in production.
# Uncomment only to override (e.g. local non-Docker dev against localhost:3001).
#   Local dev:   http://localhost:3001
#   Production:  https://<your DOMAIN>   (default; leave unset)
# NEXT_PUBLIC_API_URL=http://localhost:3001
