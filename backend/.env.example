# Backend environment variables (local, non-Docker dev)
DATABASE_URL=postgres://sparta:sparta_password@localhost:5432/sparta
JWT_SECRET=change_me_in_production
PORT=3001
# Optional: comma-separated CORS allowlist. Defaults to the production domain
# + http://localhost:3000 when unset.
# CORS_ORIGINS=https://sparta.jearimjarden.com,http://localhost:3000

# SMTP (assessment result emails). Email is disabled when SMTP_HOST is unset;
# submission is never blocked or broken by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sparta.jearimjarden.com

# OpenAI (AI features). Absent key -> AI returns a clear error; app still runs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Midtrans (real token purchases). Absent MIDTRANS_SERVER_KEY -> token purchase
# gracefully falls back to the demo credit, so local dev still works.
# Get keys from the Midtrans dashboard (Settings -> Access Keys). Point the
# gateway's Payment Notification URL at POST /api/tokens/midtrans/notification.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# 'true' uses the live endpoints; anything else (default) uses sandbox.
MIDTRANS_IS_PRODUCTION=false
# Price of one token in IDR (Midtrans charges whole rupiah). Default 1000.
TOKEN_PRICE_IDR=1000
